<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Historical queue types deliberately shadow their current counterparts in this isolated assembly. -->
    <!-- Generated fixture snapshots cannot gain #nullable directives without changing their pinned bytes. -->
    <NoWarn>$(NoWarn);CS0436;CS8669;CA2255</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Source/*.cs.txt" />
    <EmbeddedResource Include="Source/*.cs.txt" WithCulture="false"
                      LogicalName="Baton.Compatibility068.Source.%(Filename)%(Extension)" />
    <ProjectReference Include="../../src/Baton/Baton.csproj" />
  </ItemGroup>
</Project>
