<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Generates packages.lock.json so CI can cache NuGet restore (actions/setup-dotnet's
         cache-dependency-path globs **/packages.lock.json, same as Baton.Tests). -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.11.0" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="2.4.0" />
    <PackageReference Include="xunit.v3" Version="4.0.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\**\*.jsonl" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Baton.Vendors\Baton.Vendors.csproj" />
    <!-- #543: ClaudeWorkerAdapterTests spawns the real hook-check executable end to end, which
         needs Baton.Cli's build output copied alongside this test binary. Baton.Vendors itself must
         never reference Baton.Cli (ReferenceDirectionTests enforces that against the src/ project,
         not this one); this is a test-only dependency to exercise the real artifact, the same
         reason a test project routinely needs more than its production project under test does. -->
    <ProjectReference Include="..\..\src\Baton.Cli\Baton.Cli.csproj" />
    <!-- #2484: adapter failure tests run the existing source-built crash host as an inert
         Codex-shaped executable. This test-only edge does not alter production references. -->
    <ProjectReference Include="..\Baton.CrashTestHost\Baton.CrashTestHost.csproj" />
  </ItemGroup>

</Project>
