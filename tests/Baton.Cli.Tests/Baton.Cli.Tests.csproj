<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Generates packages.lock.json so CI can cache NuGet restore (actions/setup-dotnet's
         cache-dependency-path globs **/packages.lock.json, same as the other test projects). -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.11.0" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="2.4.0" />
    <PackageReference Include="xunit.v3" Version="4.0.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- #1706 review M4: the SAME real agy capture Baton.Tests reads, linked rather than copied, so the
         zero-under-read control here and the vendor-semantics measurement there cannot diverge. -->
    <None Include="..\Baton.Tests\Fixtures\agy-38c24d11-agent-response-usage.jsonl"
          Link="Fixtures\agy-38c24d11-agent-response-usage.jsonl"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Baton.Cli\Baton.Cli.csproj" />
    <ProjectReference Include="..\..\src\Baton.Vendors\Baton.Vendors.csproj" />
    <ProjectReference Include="..\..\src\Baton\Baton.csproj" />
    <ProjectReference Include="..\Baton.CrashTestHost\Baton.CrashTestHost.csproj" />
  </ItemGroup>

</Project>
