<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Baton\Baton.csproj" />
    <ProjectReference Include="..\Baton.Vendors\Baton.Vendors.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- #1458: absorbed from the standalone Baton.Daemon project (the `baton daemon` verb).
         Sdk.Web used to supply the generic-host types via its ASP.NET framework reference; after
         #1420's narrowing the plain Sdk needs the hosting package explicitly. This is the one
         PackageReference in Baton.Cli's project graph; see the CI `audit` job's own comment on
         why its NuGet cache stays off. -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- #1946: the SAME glass.html the Claude.ai artifact is published from, embedded so
         `baton daemon` can serve it from an installed tool directory with no path configuration and
         no second copy of the page. One page, two deliveries (spec/baton.md §11 C-11) — a copy under
         src/ would be the drift the record-once gate exists to stop, and the link name below is what
         GlassPage.cs resolves. -->
    <EmbeddedResource Include="..\..\tools\fleet-glass\glass.html" LogicalName="Baton.Cli.Daemon.glass.html" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- #107: pack baton as an installable global dotnet tool. No public feed exists to
       collide with, so PackageId/ToolCommandName are a local-convenience choice,
       not a namespace-squatting concern. -->
  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>baton</ToolCommandName>
    <PackageId>baton</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <!-- #1458: absorbed Baton.Mcp.Tests/Baton.Daemon.Tests into Baton.Cli.Tests along with the
         Mcp/Daemon sources. DaemonHost's test-only RunDaemonAsync(args, onHostBuilt) overload is
         internal. -->
    <InternalsVisibleTo Include="Baton.Cli.Tests" />
  </ItemGroup>

  <!-- No native-lib packaging step exists because there is no native lib to package: the
       process-execution engine (BatonTask/BatonProcessRunner) is plain managed C#, not a native
       library P/Invoked into. PackAsTool packs from a *publish* output regardless (unlike plain
       library packing, which only picks up the primary DLL), so there is nothing further to
       arrange either way. Confirmed by inspecting the packed nupkg (#107). -->

</Project>
