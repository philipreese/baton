<Project>

  <!-- release-please linked-versions migration: Baton.Cli is the "core" group's shipped artifact (the
       `baton` dotnet tool, M13), so it carries the real, release-please-patched Version — the same role
       the root Directory.Build.props used to play before the split. Baton/Baton.Vendors stay on
       the root file's static Version; nothing reads their own assembly
       version independently. Imports the root file first for shared settings
       (IncludeSourceRevisionInInformationalVersion etc.), then overrides just Version. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))"/>

  <PropertyGroup>
    <Version>0.35.0</Version>
  </PropertyGroup>

</Project>
