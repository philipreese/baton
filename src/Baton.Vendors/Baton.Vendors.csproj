<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Baton\Baton.csproj" />

    <!-- #667: AtomicLaunchConfigWriter is internal and had no direct tests, so its drift-correction
         behaviour could only be reached through ClaudeWorkerAdapter.Resolve. That meant a test had
         to hand-write the one shared claude-settings.json, and that is what forced the whole
         Baton.Vendors.Tests suite to be serialised. Testing the writer against a throwaway path
         instead removes the shared state rather than scheduling around it. -->
    <InternalsVisibleTo Include="Baton.Vendors.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- #888: the shared worker-role catalog. Copied next to the engine as the shipped default, NOT
         embedded, so an operator can retune tiers at runtime (a worker-tiers.json under BATON_HOME, or
         the BATON_WORKER_*_PATH env override) with no rebuild. tools/baton-agy-loop/dispatch.py read the
         same tracked files until #1759 retired it; tools/audit-completeness/completeness.py still reads
         WorkerTiers.json directly today. -->
    <None Include="WorkerRoles.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="WorkerTiers.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="WorkflowTemplates.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- #2110: the shipped role-default skill packages (Skills/<name>/), copied next to the engine as
         skills/<name>/ so they sit on SkillPackageResolver's next-to-the-assembly rung and a role's
         default_skills resolve against ANY workspace, not only a checkout of this repository. Copied,
         not embedded, for the same reason the catalog files above are: an operator's same-named
         package in the account library (the rung above) still wins, with no rebuild. The source
         tree sits under this project, NOT at the repository root: <repo>/skills/ is the resolver's
         <workspace>/skills/ scan rung, and a package there is inhaled by every lane that declares no
         skill set (the five roles without default_skills, and any opted-out one) when dispatched
         against this repository. The Link keeps the output directory name lowercase on a
         case-sensitive filesystem, which is what the resolver's rung path spells. -->
    <None Include="Skills\**\*" Link="skills\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- #1875: the opposite call from the three files above, for the opposite reason. Those are
         operator-tunable policy, so they are copied and re-readable at runtime. This is a dated
         recording of what `codex app-server model/list` answered (codex-cli 0.153.2, 2026-09-04) —
         evidence, not policy (what it is and what it settles: docs/vendor-capabilities.md). Embedding
         it is what stops a deployment from silently editing or losing the evidence CodexWorkerAdapter's
         validation table rests on. -->
    <EmbeddedResource Include="codex-model-list-2026-09-04.jsonl" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
