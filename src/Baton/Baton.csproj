<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
    <!-- #1458 3b: NuGet's restore graph keys each project by PackageSpec.Name, which defaults to
         PackageId when one is set. Baton.Cli packs as a dotnet tool with PackageId "baton"
         (PackAsTool, the shipped `baton` binary) and references this project by ProjectReference.
         Once this csproj's own MSBuildProjectName became "Baton" (this rename), the two collided
         case-insensitively and `dotnet build`/`restore` failed with NuGet.Commands.RestoreCommand's
         "Ambiguous project name 'baton'" (confirmed empirically: reverting either name resolves it).
         This PackageId exists ONLY to give the restore graph a distinct key; IsPackable=false means
         it is never produced as an actual package. Does not affect AssemblyName, RootNamespace, or
         the produced Baton.dll, all of which stay "Baton" per the rename. -->
    <PackageId>Baton.Engine.RestoreGraphName</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets the test project exercise internal pump machinery (e.g. InFlightExecutionRegistry's
         Register/Unregister/RequestStopAsync) directly where a test needs to force an exact
         internal race deterministically, not just through the public mutation surface. -->
    <InternalsVisibleTo Include="Baton.Tests" />
    <!-- #1496: BatonEnvironmentSnapshot.BeginScope is internal (a test-only seam, never production
         surface). Baton.Cli.Tests needs it directly: FleetStatusToolTests, RoomDetailToolTests,
         DaemonHostTests, and (#1524) RoomRetentionSweepTests isolate their env-derived state through
         a scope rather than mutating process environment. #1495's poller tests share this same
         grant. -->
    <InternalsVisibleTo Include="Baton.Cli.Tests" />
    <!-- #1524: Baton.Vendors' own readers (WorkerRoleCatalog, WorkflowTemplateCatalog and
         ClaudeWorkerAdapter) folded into BatonEnvironmentSnapshot too (tried and reverted in #1496,
         see that type's own remarks for why). WorkerRoleCatalogTests, WorkflowTemplateCatalogTests,
         CatalogNamespaceTests, and ClaudeWorkerAdapterTests need BeginScope the same way. -->
    <InternalsVisibleTo Include="Baton.Vendors.Tests" />
    <!-- #2114: LaneRoleDaemonWriteVerbTests reads the SOURCE WorkerRoles.json through the real
         WorkerRoleCatalog (so the grant it measures is the one dispatch resolves), which means
         pointing the catalog at that file through the same BeginScope seam the projects above use. -->
    <InternalsVisibleTo Include="Baton.Architecture.Tests" />
  </ItemGroup>

</Project>
