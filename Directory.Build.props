<Project>

  <!-- M13 Phase 2 (#108) set this up as the repo's single shared version. The release-please
       linked-versions era (three components — flow/vendors/cli — bumped in lock-step, with only
       Baton.Cli's local Directory.Build.props patched) ended with #1835: the repo is ONE release
       train named `baton` again, tagged `vX.Y.Z`, and release-please patches this Version and
       Baton.Cli's local one together (both are `extra-files` in release-please-config.json), so
       every project inherits the shipped version and `baton`'s version flag, the root CHANGELOG.md
       entry and the tag agree. -->
  <PropertyGroup>
    <Version>0.35.0</Version>

    <!-- The SDK defaults to appending "+<git-sha>" to AssemblyInformationalVersion, which would make
         `baton`'s version flag output ("0.7.0+<sha>") never match CHANGELOG.md's plain "0.7.0" entry —
         exactly what this phase's produced-artifact requirement rules out. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

</Project>
